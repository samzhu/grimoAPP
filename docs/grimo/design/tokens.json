{
  "$description": "Grimo design language tokens. Values are extracted from docs/grimo/ui/prototype/index.html and mapped to frontend CSS custom properties.",
  "color": {
    "$type": "color",
    "bg": {
      "$value": "oklch(98% 0.004 245)",
      "$description": "Application background."
    },
    "surface": {
      "$value": "oklch(100% 0 0)",
      "$description": "Primary panel and card surface."
    },
    "fg": {
      "$value": "oklch(18% 0.012 245)",
      "$description": "Primary readable foreground."
    },
    "muted": {
      "$value": "oklch(49% 0.018 245)",
      "$description": "Secondary text and subdued icons."
    },
    "border": {
      "$value": "oklch(90% 0.007 245)",
      "$description": "Default low-contrast UI border."
    },
    "accent": {
      "$value": "oklch(55% 0.135 152)",
      "$description": "Primary green action and selected context accent."
    },
    "warn": {
      "$value": "oklch(66% 0.135 78)",
      "$description": "Warning state."
    },
    "danger": {
      "$value": "oklch(58% 0.16 28)",
      "$description": "Danger or blocked state."
    },
    "info": {
      "$value": "oklch(57% 0.14 248)",
      "$description": "Informational state."
    }
  },
  "size": {
    "$type": "dimension",
    "topbar.height": {
      "$value": "52px",
      "$description": "Prototype topbar height."
    },
    "rail.width": {
      "$value": "172px",
      "$description": "Prototype expanded rail width."
    },
    "rail.control": {
      "$value": "34px",
      "$description": "Prototype icon/control square size."
    },
    "board.columnMinWidth": {
      "$value": "184px",
      "$description": "Prototype minimum board column width."
    },
    "board.heightOffset": {
      "$value": "110px",
      "$description": "Viewport offset used by the task board area."
    }
  },
  "space": {
    "$type": "dimension",
    "section.x": {
      "$value": "18px",
      "$description": "Horizontal padding in section headers and board lanes."
    },
    "section.y": {
      "$value": "12px",
      "$description": "Vertical padding in section headers."
    },
    "board.gap": {
      "$value": "10px",
      "$description": "Gap between board columns."
    },
    "card.gap": {
      "$value": "8px",
      "$description": "Internal task card rhythm."
    }
  },
  "radius": {
    "$type": "dimension",
    "default": {
      "$value": "6px",
      "$description": "Default prototype radius."
    },
    "large": {
      "$value": "8px",
      "$description": "Panel and dialog radius."
    }
  },
  "component": {
    "taskCard": {
      "$description": "Task card visual states.",
      "padding": {
        "$type": "dimension",
        "$value": "9px 10px"
      },
      "selectedInset": {
        "$type": "dimension",
        "$value": "2px",
        "$description": "Selected task uses inset accent, not a separate badge."
      }
    },
    "detailDrawer": {
      "$description": "Task detail drawer geometry.",
      "width": {
        "$type": "dimension",
        "$value": "clamp(460px, 34vw, 720px)"
      }
    }
  }
}
